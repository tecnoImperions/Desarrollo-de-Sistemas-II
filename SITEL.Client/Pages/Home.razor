@page "/"
@using System.Net.Http.Json
@using SITEL.Shared.Entities
@using SITEL.Shared.Enums
@inject HttpClient Http

<PageTitle>SITEL | Panel Ejecutivo de Logística</PageTitle>

@if (IniciarCargaPanel())
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 style="font-weight: 800; margin: 0; font-size: 1.6rem; color: #0F172A;">
                <i class="bi bi-speedometer2 text-primary me-2"></i>Panel Ejecutivo de Trazabilidad — SITEL
            </h2>
            <p style="color: var(--text-muted); margin: 0.25rem 0 0; font-size: 0.92rem;">
                Resumen consolidado del Módulo de Inventarios, Directorio de Clientes y Despachos en tiempo real.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/inventarios" class="btn-sitel-outline">
                <i class="bi bi-boxes"></i> Ver Inventario
            </a>
            <a href="/envios/nuevo" class="btn-sitel-primary">
                <i class="bi bi-plus-circle-fill"></i> Nuevo Despacho
            </a>
        </div>
    </div>

    <!-- KPIs Principales -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="sitel-kpi-card">
                <div class="d-flex justify-content-between align-items-center">
                    <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Despachos Activos</span>
                    <i class="bi bi-truck text-primary fs-5"></i>
                </div>
                <div style="font-size: 1.75rem; font-weight: 800; color: #0F172A; margin-top: 0.2rem;">
                    @(envios?.Count(e => e != null && !e.Anulado) ?? 0)
                </div>
                <div style="font-size: 0.8rem; color: #2563EB; font-weight: 600;">
                    <i class="bi bi-check2-circle me-1"></i>@(envios?.Count(e => e != null && !e.Anulado && e.EstadoActual == EstadoEnvio.Entregado) ?? 0) entregados con éxito
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sitel-kpi-card" style="border-left-color: #3B82F6;">
                <div class="d-flex justify-content-between align-items-center">
                    <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Clientes Corporativos</span>
                    <i class="bi bi-people-fill text-primary fs-5"></i>
                </div>
                <div style="font-size: 1.75rem; font-weight: 800; color: #0F172A; margin-top: 0.2rem;">
                    @(clientes?.Count ?? 0)
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">
                    <i class="bi bi-shield-check me-1"></i>Empresas verificadas por NIT
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sitel-kpi-card" style="border-left-color: #10B981;">
                <div class="d-flex justify-content-between align-items-center">
                    <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Stock Total en Almacén</span>
                    <i class="bi bi-boxes text-success fs-5"></i>
                </div>
                <div style="font-size: 1.75rem; font-weight: 800; color: #15803D; margin-top: 0.2rem;">
                    @(productos?.Where(p => p != null).Sum(p => p.StockActual) ?? 0)
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">
                    En @(productos?.Count ?? 0) líneas de producto
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="sitel-kpi-card" style="border-left-color: #F59E0B;">
                <div class="d-flex justify-content-between align-items-center">
                    <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Alertas / Incidencias</span>
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                </div>
                <div style="font-size: 1.75rem; font-weight: 800; color: #B45309; margin-top: 0.2rem;">
                    @((productos?.Count(p => p != null && p.StockActual <= p.StockMinimo) ?? 0) + (envios?.Count(e => e != null && !e.Anulado && e.EstadoActual == EstadoEnvio.ConIncidencia) ?? 0))
                </div>
                <div style="font-size: 0.8rem; color: #B45309; font-weight: 600;">
                    <i class="bi bi-activity me-1"></i>Monitoreo preventivo activo
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Últimos Despachos -->
        <div class="col-lg-8">
            <div class="sitel-card" style="padding: 0; overflow: hidden;">
                <div class="d-flex justify-content-between align-items-center p-3 px-4" style="border-bottom: 1px solid var(--border-color);">
                    <h5 style="font-weight: 700; margin: 0; font-size: 1rem; color: #0F172A;">
                        <i class="bi bi-truck text-primary me-2"></i>Últimos Despachos Registrados
                    </h5>
                    <a href="/mis-envios" style="font-size: 0.84rem; font-weight: 600; color: #2563EB; text-decoration: none;">
                        Ver todos <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                @if (cargando)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="small text-muted mt-2 mb-0">Sincronizando panel operativo...</p>
                    </div>
                }
                else if (envios == null || !envios.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                        <p class="text-muted small mb-2">Aún no se han registrado despachos en el sistema.</p>
                        <a href="/envios/nuevo" class="btn-sitel-primary">
                            <i class="bi bi-plus-circle"></i> Registrar Primer Envío
                        </a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="sitel-table">
                            <thead>
                                <tr>
                                    <th>Guía</th>
                                    <th>Cliente</th>
                                    <th>Carga</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in envios.Where(x => x != null).Take(6))
                                {
                                    <tr>
                                        <td style="font-family: monospace; font-weight: 700; color: #2563EB;">
                                            <i class="bi bi-upc-scan me-1"></i>@(string.IsNullOrWhiteSpace(e.Guia) ? "S/G" : e.Guia)
                                        </td>
                                        <td style="font-weight: 600;">@(e.Cliente?.NombreRazonSocial ?? e.Destinatario)</td>
                                        <td class="text-muted small">@e.DescripcionCarga</td>
                                        <td>
                                            <span class="badge-sitel @(e.Anulado ? "badge-anulado" : ObtenerBadge(e.EstadoActual))">
                                                <i class="bi @(e.Anulado ? "bi-x-circle-fill" : "bi-circle-fill")" style="font-size: 0.55rem;"></i>
                                                @(e.Anulado ? "Anulado" : e.EstadoActual.ToString())
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Estado de Inventario Crítico -->
        <div class="col-lg-4">
            <div class="sitel-card mb-4">
                <h5 style="font-weight: 700; font-size: 1rem; color: #0F172A; margin-bottom: 1rem;">
                    <i class="bi bi-boxes text-primary me-2"></i>Control de Stock en Almacén
                </h5>
                @if (cargando)
                {
                    <p class="small text-muted mb-0">Cargando catálogo de productos...</p>
                }
                else if (productos == null || !productos.Any())
                {
                    <p class="small text-muted mb-0">No hay productos registrados en el almacén.</p>
                }
                else
                {
                    @foreach (var prod in productos.Where(p => p != null).OrderBy(p => p.StockActual).Take(5))
                    {
                        <div class="d-flex justify-content-between align-items-center py-2" style="border-bottom: 1px solid #F1F5F9;">
                            <div>
                                <div style="font-weight: 600; font-size: 0.86rem; color: #0F172A;">@prod.Nombre</div>
                                <div style="font-size: 0.75rem; color: #64748B;">
                                    <i class="bi bi-tag me-1"></i>SKU: @prod.CodigoSku
                                </div>
                            </div>
                            <span class="badge-sitel @(prod.StockActual <= prod.StockMinimo ? "badge-enruta" : "badge-entregado")">
                                @prod.StockActual @prod.UnidadMedida
                            </span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private List<Envio> envios = new();
    private List<Cliente> clientes = new();
    private List<Producto> productos = new();
    private bool cargando = true;
    private bool cargaIniciada = false;

    private bool IniciarCargaPanel()
    {
        if (!cargaIniciada)
        {
            cargaIniciada = true;
            _ = CargarDatosPanelAsync();
        }
        return true;
    }

    private async Task CargarDatosPanelAsync()
    {
        cargando = true;
        try
        {
            envios = await ObtenerListaSeguraAsync<Envio>("api/envios");
            clientes = await ObtenerListaSeguraAsync<Cliente>("api/clientes");
            productos = await ObtenerListaSeguraAsync<Producto>("api/productos");
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<List<T>> ObtenerListaSeguraAsync<T>(string url)
    {
        try
        {
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var datos = await response.Content.ReadFromJsonAsync<List<T>>();
                return datos ?? new List<T>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SITEL Home] Aviso al consultar {url}: {ex.Message}");
        }
        return new List<T>();
    }

    private static string ObtenerBadge(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.Registrado => "badge-registrado",
        EstadoEnvio.Asignado => "badge-asignado",
        EstadoEnvio.EnRuta => "badge-enruta",
        EstadoEnvio.EnDestino => "badge-endestino",
        EstadoEnvio.Entregado => "badge-entregado",
        _ => "badge-incidencia"
    };
}
