@using System.Net.Http.Json
@using SITEL.Client.Services
@using SITEL.Shared.DTOs
@using SITEL.Shared.Entities
@using SITEL.Shared.Enums
@inject HttpClient Http
@inject AuthService Auth

<PageTitle>SITEL | Vista Móvil Conductor (RNF02)</PageTitle>

@if (VerificarCargaInicialConductor())
{
    <div style="max-width: 680px; margin: 0 auto;">
        <!-- Cabecera Móvil Oscura Azul Corporativo (#0F172A) -->
        <div class="p-4 mb-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 100%); color: #FFFFFF; border-radius: 16px; box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);">
            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                <div>
                    <span style="background: rgba(59, 130, 246, 0.25); border: 1px solid rgba(96, 165, 250, 0.4); color: #93C5FD; font-size: 0.72rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 999px; text-transform: uppercase;">
                        <i class="bi bi-phone-fill me-1"></i>Terminal Móvil RNF02 (Máx. 3 Pasos)
                    </span>
                    <h3 style="font-weight: 800; font-size: 1.35rem; margin: 0.5rem 0 0.15rem;">
                        Hoja de Ruta del Conductor
                    </h3>
                    <div style="font-size: 0.85rem; color: #CBD5E1;">
                        <i class="bi bi-person-badge me-1 text-info"></i>Sesión activa: <strong>@nombreUsuarioSesion</strong>
                    </div>
                </div>
                <button class="btn btn-sm btn-outline-light" style="border-radius: 8px;" @onclick="CargarDatosAsync" title="Actualizar asignaciones">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>

            <!-- PASO 1: Selector de Conductor en Turno -->
            <div class="p-2 px-3" style="background: rgba(255, 255, 255, 0.08); border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.12);">
                <label class="small fw-bold d-block mb-1" style="color: #93C5FD; font-size: 0.75rem;">
                    PASO 1 — CONDUCTOR EN TURNO (FILTRO DE ASIGNACIONES):
                </label>
                <select class="form-select form-select-sm fw-semibold" style="background-color: #FFFFFF; color: #0F172A; border: none;"
                        @bind="conductorSeleccionadoId">
                    @foreach (var c in conductoresActivos)
                    {
                        <option value="@c.Id">@c.Nombres @c.Apellidos — Lic: @c.Licencia</option>
                    }
                    <option value="0">Ver todos los despachos con conductor asignado</option>
                </select>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeOperacion))
        {
            <div class="alert @(esErrorOperacion ? "alert-danger" : "alert-success") d-flex align-items-center justify-content-between py-2 px-3 mb-3" style="border-radius: 10px;">
                <div>
                    <i class="bi @(esErrorOperacion ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill") me-2"></i>
                    <span>@mensajeOperacion</span>
                </div>
                <button type="button" class="btn-close" @onclick="() => mensajeOperacion = string.Empty"></button>
            </div>
        }

        <!-- Pestañas de Filtro Rápido (Activos vs Entregados) -->
        <div class="d-flex gap-2 mb-3">
            <button type="button"
                    class="flex-fill py-2 fw-bold"
                    style="border-radius: 10px; border: 1px solid @(mostrarEntregados ? "#CBD5E1" : "#2563EB"); background-color: @(mostrarEntregados ? "#FFFFFF" : "#2563EB"); color: @(mostrarEntregados ? "#334155" : "#FFFFFF"); font-size: 0.88rem;"
                    @onclick="() => mostrarEntregados = false">
                <i class="bi bi-truck me-1"></i>Pendientes de Entrega (@EnviosPendientesConductor.Count())
            </button>
            <button type="button"
                    class="flex-fill py-2 fw-bold"
                    style="border-radius: 10px; border: 1px solid @(mostrarEntregados ? "#2563EB" : "#CBD5E1"); background-color: @(mostrarEntregados ? "#2563EB" : "#FFFFFF"); color: @(mostrarEntregados ? "#FFFFFF" : "#334155"); font-size: 0.88rem;"
                    @onclick="() => mostrarEntregados = true">
                <i class="bi bi-check2-all me-1"></i>Completados (@EnviosEntregadosConductor.Count())
            </button>
        </div>

        <!-- Listado de Tarjetas Móviles de Despachos Asignados -->
        @if (cargando)
        {
            <div class="sitel-card text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="small text-muted mt-2 mb-0">Sincronizando despachos asignados...</p>
            </div>
        }
        else if (!ListaVisible.Any())
        {
            <div class="sitel-card text-center py-5">
                <i class="bi bi-clipboard2-check fs-1 text-muted d-block mb-2"></i>
                <h6 class="fw-bold text-secondary mb-1">
                    @(mostrarEntregados ? "Aún no hay entregas completadas en este turno" : "No tiene despachos pendientes asignados")
                </h6>
                <p class="small text-muted mb-0">
                    Cuando el operador logístico le asigne una guía (RF02), aparecerá automáticamente aquí.
                </p>
            </div>
        }
        else
        {
            @foreach (var envio in ListaVisible)
            {
                <div class="sitel-card mb-3" style="border-left: 5px solid @ObtenerColorBorde(envio.EstadoActual); padding: 1.25rem;">
                    <!-- Encabezado de la Tarjeta -->
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2" style="border-bottom: 1px solid #F1F5F9;">
                        <div>
                            <span style="font-family: monospace; font-weight: 800; font-size: 1.05rem; color: #2563EB;">
                                <i class="bi bi-upc-scan me-1"></i>@envio.Guia
                            </span>
                            <div style="font-size: 0.76rem; color: #64748B;">
                                <i class="bi bi-signpost-split me-1"></i>@(envio.Ruta?.Nombre ?? "Ruta asignada")
                            </div>
                        </div>
                        <span class="badge-sitel @ObtenerClaseBadge(envio.EstadoActual)">
                            <i class="bi bi-circle-fill" style="font-size: 0.45rem;"></i> @FormatearEstado(envio.EstadoActual)
                        </span>
                    </div>

                    <!-- Datos de Entrega y Carga -->
                    <div class="mb-3" style="font-size: 0.9rem;">
                        <div class="mb-1">
                            <strong style="color: #0F172A;"><i class="bi bi-building text-primary me-1"></i>Cliente / Destinatario:</strong>
                            <span>@(envio.Cliente?.NombreRazonSocial ?? envio.Destinatario)</span>
                        </div>
                        <div class="mb-1">
                            <strong style="color: #0F172A;"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Dirección de Entrega:</strong>
                            <span class="fw-semibold" style="color: #1E293B;">@envio.DireccionEntrega</span>
                        </div>
                        <div class="p-2 mt-2" style="background-color: #F8FAFC; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 0.84rem;">
                            <i class="bi bi-box-seam text-primary me-1"></i><strong>Carga:</strong> @envio.DescripcionCarga
                        </div>
                    </div>

                    @if (!envio.Anulado && envio.EstadoActual != EstadoEnvio.Entregado)
                    {
                        <!-- PASO 2: Botones de Acción Rápida (1 Toque) -->
                        <div class="pt-2" style="border-top: 1px dashed #CBD5E1;">
                            <div class="small fw-bold text-muted mb-2" style="font-size: 0.72rem; text-transform: uppercase;">
                                PASO 2 — SELECCIONE ACCIÓN RÁPIDA DE REPORTE:
                            </div>
                            <div class="row g-2">
                                <div class="col-4">
                                    <button type="button" class="btn w-100 py-2 fw-bold d-flex flex-column align-items-center gap-1"
                                            style="background-color: #EFF6FF; color: #1D4ED8; border: 1px solid #BFDBFE; border-radius: 10px; font-size: 0.8rem;"
                                            disabled="@procesandoAccion"
                                            @onclick="() => MarcarEnRutaDirectoAsync(envio)">
                                        <i class="bi bi-truck-front-fill fs-5"></i>
                                        <span>En Ruta</span>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn w-100 py-2 fw-bold d-flex flex-column align-items-center gap-1"
                                            style="background-color: #DCFCE7; color: #15803D; border: 1px solid #86EFAC; border-radius: 10px; font-size: 0.8rem;"
                                            disabled="@procesandoAccion"
                                            @onclick="() => AbrirPaso3Entrega(envio)">
                                        <i class="bi bi-check2-circle fs-5"></i>
                                        <span>Entregado</span>
                                    </button>
                                </div>
                                <div class="col-4">
                                    <button type="button" class="btn w-100 py-2 fw-bold d-flex flex-column align-items-center gap-1"
                                            style="background-color: #FEE2E2; color: #B91C1C; border: 1px solid #FCA5A5; border-radius: 10px; font-size: 0.8rem;"
                                            disabled="@procesandoAccion"
                                            @onclick="() => AbrirPaso3Incidencia(envio)">
                                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                        <span>Incidencia</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else if (envio.EstadoActual == EstadoEnvio.Entregado)
                    {
                        <div class="p-2 px-3 text-success small fw-semibold" style="background: #F0FDF4; border-radius: 8px; border: 1px solid #BBF7D0;">
                            <i class="bi bi-patch-check-fill me-1"></i>Entregado a: <strong>@envio.ReceptorNombre</strong> (@envio.FechaEntrega.ToString("dd/MM/yyyy HH:mm"))
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- PASO 3 (MODAL RÁPIDO): Confirmar Entrega o Reportar Incidencia -->
    @if (envioSeleccionado != null)
    {
        <div class="sitel-modal-backdrop" @onclick="CerrarModalPaso3">
            <div class="sitel-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
                <div class="sitel-modal-header" style="background-color: @(modoIncidencia ? "#991B1B" : "#0F172A");">
                    <h5 style="margin: 0; font-size: 1.02rem; font-weight: 700;">
                        @if (modoIncidencia)
                        {
                            <span><i class="bi bi-exclamation-triangle-fill me-2"></i>PASO 3: Reportar Incidencia — @envioSeleccionado.Guia</span>
                        }
                        else
                        {
                            <span><i class="bi bi-check2-circle me-2"></i>PASO 3: Confirmar Entrega — @envioSeleccionado.Guia</span>
                        }
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalPaso3"></button>
                </div>

                <div class="sitel-modal-body">
                    @if (!string.IsNullOrEmpty(errorModalPaso3))
                    {
                        <div class="alert alert-danger py-2 small">
                            <i class="bi bi-exclamation-octagon-fill me-1"></i>@errorModalPaso3
                        </div>
                    }

                    @if (!modoIncidencia)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-secondary">Nombre Completo de Quien Recibe <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="receptorNombre" placeholder="Ej. Sr. Luis Fernando Mamani (Encargado)" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-secondary">Evidencia de Recepción (C.I. / Sello / Nota de Conformidad) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" @bind="evidenciaEntrega" placeholder="Ej. CI 4829102 SC - Sello de Almacén Recibido Conforme" />
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-danger">Seleccione el Motivo de la Incidencia <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="motivoIncidencia">
                                <option value="@MotivoIncidencia.DestinatarioAusente">Destinatario Ausente en Punto de Entrega</option>
                                <option value="@MotivoIncidencia.DireccionErronea">Dirección Errónea / No Ubicada</option>
                                <option value="@MotivoIncidencia.Dano">Daño o Merma Detectada en Carga</option>
                                <option value="@MotivoIncidencia.Otro">Bloqueo de Vía / Otro Imprevisto</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-secondary">Breve Descripción o Evidencia del Problema <span class="text-danger">*</span></label>
                            <textarea class="form-control" rows="2" @bind="detalleIncidencia" placeholder="Ej. Local cerrado tras 20 minutos de espera; se notificó por teléfono..."></textarea>
                        </div>
                    }
                </div>

                <div class="sitel-modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalPaso3">Cancelar</button>
                    <button type="button"
                            class="btn @(modoIncidencia ? "btn-danger" : "btn-success") fw-bold px-4"
                            disabled="@procesandoAccion"
                            @onclick="ConfirmarPaso3Async">
                        <i class="bi @(modoIncidencia ? "bi-send-exclamation-fill" : "bi-check2-all") me-1"></i>
                        @(procesandoAccion ? "Registrando..." : (modoIncidencia ? "Enviar Incidencia" : "Finalizar Entrega"))
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private List<Envio> todosLosEnvios = new();
    private List<Conductor> conductoresActivos = new();

    private int conductorSeleccionadoId = 0;
    private string nombreUsuarioSesion = "Conductor SITEL";
    private bool mostrarEntregados = false;
    private bool cargando = true;
    private bool cargaIniciada = false;
    private bool procesandoAccion = false;

    private string mensajeOperacion = string.Empty;
    private bool esErrorOperacion = false;

    // Estado del Paso 3 (Modal rápido)
    private Envio? envioSeleccionado;
    private bool modoIncidencia = false;
    private string receptorNombre = string.Empty;
    private string evidenciaEntrega = "Acta firmada y sello de recepción conforme";
    private MotivoIncidencia motivoIncidencia = MotivoIncidencia.DestinatarioAusente;
    private string detalleIncidencia = string.Empty;
    private string errorModalPaso3 = string.Empty;

    private IEnumerable<Envio> EnviosDelConductor => todosLosEnvios
        .Where(e => e != null && !e.Anulado)
        .Where(e =>
        {
            if (conductorSeleccionadoId > 0)
                return e.ConductorId == conductorSeleccionadoId;

            return e.Conductor != null && !e.Conductor.Nombres.Contains("Sin Asignar", StringComparison.OrdinalIgnoreCase);
        });

    private IEnumerable<Envio> EnviosPendientesConductor =>
        EnviosDelConductor.Where(e => e.EstadoActual != EstadoEnvio.Entregado);

    private IEnumerable<Envio> EnviosEntregadosConductor =>
        EnviosDelConductor.Where(e => e.EstadoActual == EstadoEnvio.Entregado);

    private IEnumerable<Envio> ListaVisible =>
        mostrarEntregados ? EnviosEntregadosConductor : EnviosPendientesConductor;

    private bool VerificarCargaInicialConductor()
    {
        if (!cargaIniciada)
        {
            cargaIniciada = true;
            _ = InicializarConductorAsync();
        }
        return true;
    }

    private async Task InicializarConductorAsync()
    {
        var sesion = await Auth.ObtenerSesionActualAsync();
        nombreUsuarioSesion = sesion.NombreCompleto;
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        try
        {
            var respConductores = await Http.GetAsync("api/conductores");
            if (respConductores.IsSuccessStatusCode)
            {
                var lista = await respConductores.Content.ReadFromJsonAsync<List<Conductor>>() ?? new();
                conductoresActivos = lista
                    .Where(c => c != null && !c.Nombres.Contains("Sin Asignar", StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            var respEnvios = await Http.GetAsync("api/envios");
            if (respEnvios.IsSuccessStatusCode)
            {
                todosLosEnvios = await respEnvios.Content.ReadFromJsonAsync<List<Envio>>() ?? new();
            }

            if (conductorSeleccionadoId == 0 && conductoresActivos.Any())
            {
                var coincidenciaNombre = conductoresActivos.FirstOrDefault(c =>
                    nombreUsuarioSesion.Contains(c.Nombres, StringComparison.OrdinalIgnoreCase) ||
                    nombreUsuarioSesion.Contains(c.Apellidos, StringComparison.OrdinalIgnoreCase));

                if (coincidenciaNombre != null)
                {
                    conductorSeleccionadoId = coincidenciaNombre.Id;
                }
                else
                {
                    var conEnvios = conductoresActivos.FirstOrDefault(c => todosLosEnvios.Any(e => e.ConductorId == c.Id));
                    conductorSeleccionadoId = conEnvios?.Id ?? conductoresActivos.First().Id;
                }
            }
        }
        catch (Exception ex)
        {
            esErrorOperacion = true;
            mensajeOperacion = $"Error de sincronización móvil: {ex.Message}";
        }
        finally
        {
            cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task MarcarEnRutaDirectoAsync(Envio envio)
    {
        procesandoAccion = true;
        mensajeOperacion = string.Empty;

        try
        {
            var dto = new ActualizarEstadoEnvioDto
            {
                NuevoEstado = EstadoEnvio.EnRuta,
                Ubicacion = envio.Ruta?.Origen ?? "Unidad Móvil en Tránsito GPS",
                Observaciones = $"Salida a ruta confirmada desde terminal móvil por {nombreUsuarioSesion}.",
                RegistradoPor = nombreUsuarioSesion
            };

            var resp = await Http.PutAsJsonAsync($"api/envios/{envio.Id}/estado", dto);
            if (resp.IsSuccessStatusCode)
            {
                esErrorOperacion = false;
                mensajeOperacion = $"Guía {envio.Guia} actualizada a 'En Ruta' correctamente.";
                await CargarDatosAsync();
            }
            else
            {
                esErrorOperacion = true;
                var err = await resp.Content.ReadFromJsonAsync<ApiMessageResponse>();
                mensajeOperacion = err?.Mensaje ?? "No se pudo cambiar a 'En Ruta'.";
            }
        }
        catch (Exception ex)
        {
            esErrorOperacion = true;
            mensajeOperacion = $"Error: {ex.Message}";
        }
        finally
        {
            procesandoAccion = false;
        }
    }

    private void AbrirPaso3Entrega(Envio envio)
    {
        envioSeleccionado = envio;
        modoIncidencia = false;
        receptorNombre = envio.Destinatario;
        evidenciaEntrega = "Recibido conforme con firma y sello";
        errorModalPaso3 = string.Empty;
    }

    private void AbrirPaso3Incidencia(Envio envio)
    {
        envioSeleccionado = envio;
        modoIncidencia = true;
        motivoIncidencia = MotivoIncidencia.DestinatarioAusente;
        detalleIncidencia = string.Empty;
        errorModalPaso3 = string.Empty;
    }

    private void CerrarModalPaso3()
    {
        envioSeleccionado = null;
        errorModalPaso3 = string.Empty;
    }

    private async Task ConfirmarPaso3Async()
    {
        if (envioSeleccionado == null) return;

        if (!modoIncidencia && string.IsNullOrWhiteSpace(receptorNombre))
        {
            errorModalPaso3 = "Debe indicar el nombre de la persona que recibe la carga.";
            return;
        }

        if (modoIncidencia && string.IsNullOrWhiteSpace(detalleIncidencia))
        {
            errorModalPaso3 = "Debe detallar brevemente qué ocurrió en el punto de entrega.";
            return;
        }

        procesandoAccion = true;
        errorModalPaso3 = string.Empty;

        try
        {
            var dto = new ActualizarEstadoEnvioDto
            {
                NuevoEstado = modoIncidencia ? EstadoEnvio.ConIncidencia : EstadoEnvio.Entregado,
                Ubicacion = envioSeleccionado.DireccionEntrega,
                RegistradoPor = nombreUsuarioSesion,
                ReceptorNombre = modoIncidencia ? string.Empty : receptorNombre.Trim(),
                MotivoIncidencia = modoIncidencia ? motivoIncidencia : null,
                DescripcionIncidencia = modoIncidencia ? detalleIncidencia.Trim() : string.Empty,
                Observaciones = modoIncidencia
                    ? $"Reporte móvil de incidencia: {detalleIncidencia.Trim()}"
                    : $"Evidencia de entrega: {evidenciaEntrega.Trim()}"
            };

            var resp = await Http.PutAsJsonAsync($"api/envios/{envioSeleccionado.Id}/estado", dto);
            if (resp.IsSuccessStatusCode)
            {
                esErrorOperacion = false;
                mensajeOperacion = modoIncidencia
                    ? $"Incidencia reportada en la guía {envioSeleccionado.Guia}."
                    : $"Entrega de la guía {envioSeleccionado.Guia} registrada con éxito.";
                envioSeleccionado = null;
                await CargarDatosAsync();
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ApiMessageResponse>();
                errorModalPaso3 = err?.Mensaje ?? "No se pudo guardar la actualización.";
            }
        }
        catch (Exception ex)
        {
            errorModalPaso3 = $"Error: {ex.Message}";
        }
        finally
        {
            procesandoAccion = false;
        }
    }

    private static string ObtenerColorBorde(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.Asignado => "#2563EB",
        EstadoEnvio.EnRuta => "#F59E0B",
        EstadoEnvio.EnDestino => "#4F46E5",
        EstadoEnvio.Entregado => "#10B981",
        EstadoEnvio.ConIncidencia => "#EF4444",
        _ => "#64748B"
    };

    private static string ObtenerClaseBadge(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.Registrado => "badge-registrado",
        EstadoEnvio.Asignado => "badge-asignado",
        EstadoEnvio.EnRuta => "badge-enruta",
        EstadoEnvio.EnDestino => "badge-endestino",
        EstadoEnvio.Entregado => "badge-entregado",
        _ => "badge-incidencia"
    };

    private static string FormatearEstado(EstadoEnvio estado) => estado switch
    {
        EstadoEnvio.Registrado => "Registrado",
        EstadoEnvio.Asignado => "Asignado",
        EstadoEnvio.EnRuta => "En Ruta",
        EstadoEnvio.EnDestino => "En Destino",
        EstadoEnvio.Entregado => "Entregado",
        EstadoEnvio.ConIncidencia => "Con Incidencia",
        EstadoEnvio.Retrasado => "Retrasado",
        _ => estado.ToString()
    };
}
