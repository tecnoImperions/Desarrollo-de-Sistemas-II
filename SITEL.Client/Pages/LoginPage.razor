@page "/login"
@using System.ComponentModel.DataAnnotations
@using SITEL.Client.Services
@using SITEL.Shared.Enums
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>SITEL | Iniciar Sesión</PageTitle>

<div class="sitel-auth-page">
    <div class="sitel-auth-card">
        <!-- Cabecera de marca visible en móvil (full-width edge-to-edge) -->
        <div class="sitel-mobile-brand-header d-lg-none">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span style="background: #2563EB; padding: 0.4rem 0.65rem; border-radius: 10px; font-size: 1.1rem; display: inline-flex;">
                    <i class="bi bi-box-seam-fill text-white"></i>
                </span>
                <div>
                    <div style="font-weight: 800; font-size: 1.2rem; line-height: 1.1;">
                        SITEL <span style="color: #60A5FA; font-weight: 600;">Logistics</span>
                    </div>
                    <div style="font-size: 0.76rem; color: #CBD5E1;">Sistema de Trazabilidad Logística</div>
                </div>
            </div>
        </div>

        <div class="row g-0">
            <!-- Panel Izquierdo: Identidad Corporativa SITEL (Escritorio) -->
            <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-5"
                 style="background: linear-gradient(155deg, #1E3A8A 0%, #0F172A 100%); color: #FFFFFF;">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <span style="background: #2563EB; padding: 0.45rem 0.7rem; border-radius: 10px; font-size: 1.25rem; display: inline-flex;">
                            <i class="bi bi-box-seam-fill text-white"></i>
                        </span>
                        <span style="font-weight: 800; font-size: 1.35rem; letter-spacing: 0.02em;">
                            SITEL <span style="color: #60A5FA; font-weight: 600;">Logistics</span>
                        </span>
                    </div>

                    <h3 style="font-weight: 800; font-size: 1.65rem; line-height: 1.25; margin-bottom: 1rem;">
                        Trazabilidad Logística y Control de Entregas
                    </h3>
                    <p style="color: #CBD5E1; font-size: 0.92rem; line-height: 1.6;">
                        Plataforma empresarial para el monitoreo de despachos en tiempo real, control de inventarios en almacén y gestión operativa de flota.
                    </p>
                </div>

                <div class="mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.12); font-size: 0.82rem; color: #94A3B8;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-shield-check text-info"></i>
                        <span>Acceso seguro por perfil de usuario</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-upc-scan text-info"></i>
                        <span>Control único por número de guía</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-phone-fill text-info"></i>
                        <span>Seguimiento ágil desde cualquier dispositivo</span>
                    </div>
                </div>
            </div>

            <!-- Panel Derecho: Formulario de Autenticación -->
            <div class="col-lg-7 sitel-auth-body">
                <!-- Cabecera de marca limpia sobre el formulario en escritorio -->
                <div class="d-none d-lg-flex align-items-center gap-2 mb-3 pb-3" style="border-bottom: 1px solid #F1F5F9;">
                    <span style="background: #EFF6FF; color: #2563EB; padding: 0.35rem 0.55rem; border-radius: 8px; display: inline-flex;">
                        <i class="bi bi-box-seam-fill"></i>
                    </span>
                    <span style="font-weight: 800; font-size: 0.95rem; color: #0F172A;">SITEL</span>
                    <span style="font-size: 0.82rem; color: #64748B;">· Sistema de Trazabilidad Logística</span>
                </div>

                <div class="mb-4">
                    <h4 style="font-weight: 800; color: #0F172A; margin: 0;">Iniciar Sesión</h4>
                    <p style="color: #64748B; font-size: 0.88rem; margin: 0.25rem 0 0;">
                        Ingrese sus credenciales para continuar.
                    </p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 small mb-3" role="alert">
                        <i class="bi bi-exclamation-octagon-fill fs-6"></i>
                        <div>@errorMessage</div>
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope-fill text-secondary"></i></span>
                            <InputText type="email" class="form-control sitel-touch-control" @bind-Value="loginModel.Email" placeholder="usuario@sitel.bo" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Contraseña <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock-fill text-secondary"></i></span>
                            <InputText type="@(mostrarPassword ? "text" : "password")" class="form-control sitel-touch-control" @bind-Value="loginModel.Password" placeholder="••••••••" />
                            <button type="button" class="btn btn-outline-secondary sitel-touch-control px-3" @onclick="() => mostrarPassword = !mostrarPassword" title="Mostrar / Ocultar contraseña">
                                <i class="bi @(mostrarPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn-sitel-primary sitel-touch-control w-100 justify-content-center" style="font-size: 0.98rem;" disabled="@autenticando">
                        @if (autenticando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Verificando credenciales...</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Ingresar al Sistema</span>
                        }
                    </button>
                </EditForm>

                <!-- Consulta pública de rastreo para Clientes -->
                <div class="mt-4 pt-3" style="border-top: 1px solid #E2E8F0;">
                    <div class="p-3 rounded-3" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                        <div class="small fw-semibold text-secondary mb-2 text-center">
                            ¿Es cliente y desea conocer el estado de su envío?
                        </div>
                        <a href="/rastreo" class="btn-sitel-outline sitel-touch-control w-100 justify-content-center" id="btn-rastreo-publico" style="text-decoration: none;">
                            <i class="bi bi-search"></i>
                            <span>Rastrear mi envío por N° de Guía</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool mostrarPassword = false;
    private bool autenticando = false;
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        autenticando = true;
        errorMessage = string.Empty;

        try
        {
            var resultado = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
            if (resultado.Exito)
            {
                RedirigirSegunRol(resultado.Rol);
            }
            else
            {
                errorMessage = resultado.Mensaje;
            }
        }
        finally
        {
            autenticando = false;
        }
    }

    private void RedirigirSegunRol(string? rol)
    {
        Navigation.NavigateTo(ControlAcceso.RutaInicio(rol));
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "El correo electrónico es obligatorio.")]
        [EmailAddress(ErrorMessage = "Ingrese un correo electrónico válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        [MinLength(4, ErrorMessage = "La contraseña debe tener al menos 4 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }
}
