@page "/rastreo"
@using System.Net
@using System.Net.Http.Json
@using SITEL.Shared.DTOs
@inject HttpClient Http

<PageTitle>SITEL | Rastrea tu envío</PageTitle>

<div class="sitel-auth-page">
    <div class="sitel-auth-card sitel-auth-card--narrow">
        <!-- Encabezado corporativo full-width en móvil -->
        <div class="sitel-mobile-brand-header p-md-5">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span style="background: #2563EB; padding: 0.4rem 0.65rem; border-radius: 10px; font-size: 1.1rem; display: inline-flex;">
                        <i class="bi bi-box-seam-fill text-white"></i>
                    </span>
                    <span style="font-weight: 800; font-size: 1.2rem;">
                        SITEL <span style="color: #60A5FA; font-weight: 600;">Rastreo</span>
                    </span>
                </div>
                <a href="/login" class="btn btn-sm btn-outline-light" style="border-radius: 8px; min-height: 36px; display: inline-flex; align-items: center;">
                    <i class="bi bi-arrow-left me-1"></i>Iniciar Sesión
                </a>
            </div>
            <h4 class="fw-bold mb-1">Rastrea tu envío</h4>
            <p class="mb-0 small" style="color: #CBD5E1;">
                Ingresa tu código de guía (ej. <code>SIT-20261120-1735</code>) para ver el estado y recorrido en tiempo real.
            </p>
        </div>

        <!-- Formulario de búsqueda -->
        <div class="sitel-auth-body">
            <div class="sitel-rastreo-search mb-3">
                <div class="input-group sitel-rastreo-input-wrap">
                    <span class="input-group-text bg-light"><i class="bi bi-upc-scan text-primary"></i></span>
                    <input type="text"
                           id="input-guia-rastreo"
                           class="form-control sitel-touch-control"
                           placeholder="Ej. SIT-20261120-1735"
                           @bind="codigoGuia"
                           @bind:event="oninput"
                           @onkeydown="AlPresionarTecla" />
                </div>
                <button type="button"
                        id="btn-consultar-guia"
                        class="btn-sitel-primary sitel-touch-control px-4 justify-content-center"
                        disabled="@consultando"
                        @onclick="ConsultarGuiaAsync">
                    @if (consultando)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Buscando...</span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                        <span>Consultar</span>
                    }
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div id="rastreo-error" class="alert alert-warning d-flex align-items-center gap-2 small mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@mensajeError</div>
                </div>
            }

            @if (resultado != null)
            {
                <div id="rastreo-resultado" class="mt-3">
                    <div class="p-3 rounded-3 mb-4" style="background-color: #F8FAFC; border: 1px solid #E2E8F0;">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <div>
                                <div class="small text-secondary fw-semibold">GUÍA DE DESPACHO</div>
                                <div class="fs-5 fw-bold text-dark" id="rastreo-guia">@resultado.Guia</div>
                            </div>
                            <span id="rastreo-estado" class="badge rounded-pill px-3 py-2 @ObtenerClaseEstado(resultado.EstadoActual)">
                                @resultado.EstadoActual
                            </span>
                        </div>

                        <div class="row g-3 small">
                            <div class="col-6">
                                <div class="text-secondary">Origen</div>
                                <div class="fw-semibold text-dark">@resultado.Origen</div>
                            </div>
                            <div class="col-6">
                                <div class="text-secondary">Destino</div>
                                <div class="fw-semibold text-dark">@resultado.Destino</div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="text-secondary">Registrado</div>
                                <div class="fw-semibold text-dark">@resultado.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="text-secondary">Entrega Estimada</div>
                                <div class="fw-semibold text-dark">@resultado.FechaEstimada.ToString("dd/MM/yyyy")</div>
                            </div>
                            <div class="col-12 col-sm-4">
                                <div class="text-secondary">Entrega Real</div>
                                <div class="fw-semibold text-dark">
                                    @(resultado.FechaEntrega.HasValue ? resultado.FechaEntrega.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")
                                </div>
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-3">
                        <i class="bi bi-clock-history text-primary me-1"></i>Historial de Trazabilidad
                    </h6>

                    @if (resultado.Historial.Count == 0)
                    {
                        <p class="small text-secondary">Aún no se registraron movimientos para esta guía.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in resultado.Historial)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <span class="badge bg-primary-subtle text-primary-emphasis me-2">@item.Estado</span>
                                            <strong class="small text-dark">@item.Ubicacion</strong>
                                        </div>
                                        <span class="small text-secondary text-nowrap">@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(item.Observaciones))
                                    {
                                        <div class="small text-secondary mt-1">@item.Observaciones</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string codigoGuia = string.Empty;
    private bool consultando;
    private string mensajeError = string.Empty;
    private RastreoEnvioDto? resultado;

    private async Task AlPresionarTecla(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConsultarGuiaAsync();
        }
    }

    public async Task ConsultarGuiaAsync()
    {
        mensajeError = string.Empty;
        resultado = null;

        if (string.IsNullOrWhiteSpace(codigoGuia))
        {
            mensajeError = "Ingrese un número de guía para realizar la consulta.";
            return;
        }

        consultando = true;
        try
        {
            var guiaLimpia = Uri.EscapeDataString(codigoGuia.Trim());
            var response = await Http.GetAsync($"api/envios/rastreo/{guiaLimpia}");

            if (response.IsSuccessStatusCode)
            {
                resultado = await response.Content.ReadFromJsonAsync<RastreoEnvioDto>();
            }
            else if (response.StatusCode == HttpStatusCode.NotFound)
            {
                var err = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
                mensajeError = err?.Mensaje ?? "No se encontró ningún envío con esa guía.";
            }
            else
            {
                mensajeError = "No se pudo consultar el estado del envío en este momento.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión al consultar la guía: {ex.Message}";
        }
        finally
        {
            consultando = false;
        }
    }

    private static string ObtenerClaseEstado(string estado) => estado switch
    {
        "Entregado" => "bg-success text-white",
        "Anulado" or "ConIncidencia" => "bg-danger text-white",
        "EnRuta" or "EnDestino" => "bg-primary text-white",
        _ => "bg-secondary text-white"
    };
}
