@page "/envios/nuevo"
@using System.Net.Http.Json
@using SITEL.Shared.DTOs
@using SITEL.Shared.Entities
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>SITEL | Registrar Nuevo Despacho</PageTitle>

<div style="max-width: 980px; margin: 0 auto;">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 style="font-weight: 800; margin: 0; font-size: 1.55rem; color: #0F172A;">
                <i class="bi bi-plus-circle-fill text-primary me-2"></i>Registrar Orden de Despacho
            </h2>
            <p style="color: var(--text-muted); margin: 0.25rem 0 0; font-size: 0.9rem;">
                Generación de Guía Única (RN01), reserva transaccional de stock en almacén y asignación de ruta (RF02).
            </p>
        </div>
        <a href="/mis-envios" class="btn-sitel-outline">
            <i class="bi bi-arrow-left"></i> Volver a Despachos
        </a>
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div><strong>Validación de Transacción:</strong> @mensajeError</div>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeExitoCatalogo))
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between py-2 px-3 mb-4" role="alert">
            <div>
                <i class="bi bi-check-circle-fill me-2"></i>@mensajeExitoCatalogo
            </div>
            <button type="button" class="btn-close" @onclick="() => mensajeExitoCatalogo = string.Empty"></button>
        </div>
    }

    <EditForm Model="@solicitudEnvio" OnValidSubmit="GuardarDespachoAsync">
        <DataAnnotationsValidator />

        <!-- Sección 1: Guía Única (RN01) y Cliente Destinatario -->
        <div class="sitel-card mb-4">
            <h5 style="font-weight: 700; font-size: 1.02rem; color: #0F172A; margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border-color);">
                <i class="bi bi-upc-scan text-primary me-2"></i>1. Identificación de Guía (RN01) y Cliente Destinatario
            </h5>

            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary">Número de Guía Única (RN01 - Inmodificable)</label>
                    <div class="input-group">
                        <input type="text" class="form-control fw-bold" style="background-color: #F1F5F9; color: #1D4ED8; font-family: monospace;"
                               value="@solicitudEnvio.Guia" readonly />
                        <button type="button" class="btn btn-outline-secondary" title="Generar nuevo correlativo" @onclick="GenerarNuevaGuia">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                    <div class="form-text" style="font-size: 0.75rem;">Código único autogenerado. Una vez emitido no puede alterarse.</div>
                </div>

                <div class="col-md-7">
                    <label class="form-label small fw-bold text-secondary">Cliente Destinatario <span class="text-danger">*</span></label>
                    <select class="form-select" value="@solicitudEnvio.ClienteId" @onchange="OnClienteSeleccionado">
                        <option value="0">-- Seleccione un cliente del directorio --</option>
                        @foreach (var cli in listaClientes)
                        {
                            <option value="@cli.Id">@cli.NombreRazonSocial (NIT: @cli.DocumentoNit)</option>
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label small fw-bold text-secondary">Contacto / Persona que Recibe <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="solicitudEnvio.Destinatario" placeholder="Nombre del encargado de recepción" />
                    <ValidationMessage For="@(() => solicitudEnvio.Destinatario)" class="text-danger small" />
                </div>

                <div class="col-md-7">
                    <label class="form-label small fw-bold text-secondary">Dirección Exacta de Entrega <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="solicitudEnvio.DireccionEntrega" placeholder="Av. / Calle / Anillo / Zona industrial" />
                    <ValidationMessage For="@(() => solicitudEnvio.DireccionEntrega)" class="text-danger small" />
                </div>
            </div>
        </div>

        <!-- Sección 2: Selección de Mercancía desde Inventario (Control de Stock) -->
        <div class="sitel-card mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                <h5 style="font-weight: 700; font-size: 1.02rem; color: #0F172A; margin: 0;">
                    <i class="bi bi-boxes text-primary me-2"></i>2. Detalle de Mercancía e Inventario Asociado
                </h5>
                <span class="badge-sitel badge-asignado">
                    <i class="bi bi-speedometer"></i> Peso Total Estimado: @PesoTotalCalculado.ToString("0.0") Kg
                </span>
            </div>

            <div class="row g-2 align-items-end mb-3 p-3" style="background-color: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 10px;">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-secondary">Seleccionar Producto en Almacén (Stock Disponible)</label>
                    <select class="form-select" @bind="productoSeleccionadoId">
                        <option value="0">-- Seleccione abarrotes o insumos en stock --</option>
                        @foreach (var prod in productosDisponibles)
                        {
                            <option value="@prod.Id">
                                [@prod.CodigoSku] @prod.Nombre — Disp: @DisponibilidadRestante(prod) @prod.UnidadMedida (@prod.PesoUnitarioKg Kg/u)
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-secondary">Cantidad</label>
                    <input type="number" min="1" class="form-control" @bind="cantidadSeleccionada" />
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn-sitel-primary w-100 justify-content-center" @onclick="AgregarItemCarga">
                        <i class="bi bi-cart-plus-fill"></i> Añadir a la Carga
                    </button>
                </div>
            </div>

            @if (solicitudEnvio.ItemsCarga != null && solicitudEnvio.ItemsCarga.Any())
            {
                <div class="table-responsive mb-3">
                    <table class="sitel-table">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Mercancía</th>
                                <th>Cantidad</th>
                                <th>Peso Subtotal</th>
                                <th class="text-end">Quitar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in solicitudEnvio.ItemsCarga)
                            {
                                var prodInfo = productosDisponibles.FirstOrDefault(p => p.Id == item.ProductoId);
                                <tr>
                                    <td style="font-family: monospace; font-weight: 700; color: #2563EB;">@(prodInfo?.CodigoSku ?? "-")</td>
                                    <td style="font-weight: 600;">@(prodInfo?.Nombre ?? $"Producto #{item.ProductoId}")</td>
                                    <td>
                                        <span class="badge-sitel badge-entregado">@item.Cantidad @(prodInfo?.UnidadMedida ?? "Unid.")</span>
                                    </td>
                                    <td>@(((prodInfo?.PesoUnitarioKg ?? 0m) * item.Cantidad).ToString("0.0")) Kg</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarItemCarga(item.ProductoId)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div>
                <label class="form-label small fw-bold text-secondary">Descripción Consolidada de la Carga / Instrucciones de Estiba <span class="text-danger">*</span></label>
                <InputText class="form-control" @bind-Value="solicitudEnvio.DescripcionCarga"
                           placeholder="Ej. 10 Sacos de Arroz Grano de Oro + 5 Cajas de Aceite Vegetal (Carga paletizada)" />
                <ValidationMessage For="@(() => solicitudEnvio.DescripcionCarga)" class="text-danger small" />
            </div>
        </div>

        <!-- Sección 3: Asignación de Conductor y Ruta (RF02) con Alta Rápida en Modal -->
        <div class="sitel-card mb-4">
            <h5 style="font-weight: 700; font-size: 1.02rem; color: #0F172A; margin-bottom: 1rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--border-color);">
                <i class="bi bi-truck text-primary me-2"></i>3. Asignación de Flota, Ruta (RF02) y Fecha Estimada
            </h5>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-bold text-secondary m-0">Conductor Asignado (RF02)</label>
                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" style="font-size: 0.76rem; color: #2563EB;"
                                @onclick="AbrirModalConductorRapido">
                            <i class="bi bi-plus-circle-fill"></i> Nuevo Conductor
                        </button>
                    </div>
                    <InputSelect class="form-select" @bind-Value="solicitudEnvio.ConductorId">
                        @foreach (var cond in listaConductores)
                        {
                            <option value="@cond.Id">
                                @cond.Nombres @cond.Apellidos @(cond.Licencia != "N/A" ? $"({cond.Licencia})" : "")
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-5">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-bold text-secondary m-0">Ruta Logística (RF02)</label>
                        <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" style="font-size: 0.76rem; color: #2563EB;"
                                @onclick="AbrirModalRutaRapida">
                            <i class="bi bi-plus-circle-fill"></i> Nueva Ruta
                        </button>
                    </div>
                    <InputSelect class="form-select" @bind-Value="solicitudEnvio.RutaId">
                        @foreach (var ruta in listaRutas)
                        {
                            <option value="@ruta.Id">
                                @ruta.Nombre @(ruta.DistanciaKm > 0 ? $"({ruta.DistanciaKm} Km)" : "")
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-secondary mb-1">Fecha Estimada Entrega</label>
                    <InputDate class="form-control" @bind-Value="solicitudEnvio.FechaEstimada" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4 pt-3" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
                <button type="submit" class="btn-sitel-primary" disabled="@cargando">
                    @if (cargando)
                    {
                        <span><i class="bi bi-arrow-repeat me-1"></i>Ejecutando transacción segura...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-check2-circle me-1"></i>Confirmar Despacho y Emitir Guía</span>
                    }
                </button>
            </div>
        </div>
    </EditForm>
</div>

<!-- MODAL ALTA RÁPIDA DE CONDUCTOR -->
@if (mostrarModalConductor)
{
    <div class="sitel-modal-backdrop" @onclick="() => mostrarModalConductor = false">
        <div class="sitel-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="sitel-modal-header">
                <h5 style="margin: 0; font-size: 1.05rem; font-weight: 700;">
                    <i class="bi bi-person-plus-fill me-2"></i>Alta Rápida de Conductor
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalConductor = false"></button>
            </div>
            <div class="sitel-modal-body">
                @if (!string.IsNullOrEmpty(errorModalCatalogo))
                {
                    <div class="alert alert-danger py-2 small">@errorModalCatalogo</div>
                }
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Nombres <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="nuevoConductor.Nombres" placeholder="Ej. Javier" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Apellidos <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="nuevoConductor.Apellidos" placeholder="Ej. Paz Soldán" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Documento CI <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="nuevoConductor.Documento" placeholder="Ej. 5910283 SC" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Licencia <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="nuevoConductor.Licencia">
                            <option value="Cat. C - Pesados">Cat. C - Pesados</option>
                            <option value="Cat. B - Camiones">Cat. B - Camiones</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Teléfono Móvil</label>
                        <input type="text" class="form-control" @bind="nuevoConductor.Telefono" placeholder="Ej. 70099112" />
                    </div>
                </div>
            </div>
            <div class="sitel-modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => mostrarModalConductor = false">Cancelar</button>
                <button type="button" class="btn-sitel-primary" @onclick="GuardarConductorRapidoAsync" disabled="@guardandoCatalogo">
                    <i class="bi bi-floppy-fill"></i> @(guardandoCatalogo ? "Guardando..." : "Guardar y Seleccionar")
                </button>
            </div>
        </div>
    </div>
}

<!-- MODAL ALTA RÁPIDA DE RUTA -->
@if (mostrarModalRuta)
{
    <div class="sitel-modal-backdrop" @onclick="() => mostrarModalRuta = false">
        <div class="sitel-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="sitel-modal-header">
                <h5 style="margin: 0; font-size: 1.05rem; font-weight: 700;">
                    <i class="bi bi-signpost-2-fill me-2"></i>Alta Rápida de Ruta Logística
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalRuta = false"></button>
            </div>
            <div class="sitel-modal-body">
                @if (!string.IsNullOrEmpty(errorModalCatalogo))
                {
                    <div class="alert alert-danger py-2 small">@errorModalCatalogo</div>
                }
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-bold">Nombre de Ruta <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="nuevaRuta.Nombre" placeholder="Ej. Ruta Industrial Este — Cotoca" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Origen <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="nuevaRuta.Origen" placeholder="Parque Industrial SCZ" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Destino <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" @bind="nuevaRuta.Destino" placeholder="Cotoca Centro" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-bold">Distancia (Km)</label>
                        <input type="number" step="0.5" min="1" class="form-control" @bind="nuevaRuta.DistanciaKm" />
                    </div>
                </div>
            </div>
            <div class="sitel-modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="() => mostrarModalRuta = false">Cancelar</button>
                <button type="button" class="btn-sitel-primary" @onclick="GuardarRutaRapidaAsync" disabled="@guardandoCatalogo">
                    <i class="bi bi-floppy-fill"></i> @(guardandoCatalogo ? "Guardando..." : "Guardar y Seleccionar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private CrearEnvioRequestDto solicitudEnvio = new()
    {
        Guia = GenerarCodigoGuia(),
        FechaEstimada = DateTime.Today.AddDays(1)
    };

    private List<Cliente> listaClientes = new();
    private List<Conductor> listaConductores = new();
    private List<Ruta> listaRutas = new();
    private List<Producto> productosDisponibles = new();

    private int productoSeleccionadoId = 0;
    private int cantidadSeleccionada = 1;

    private bool cargando = false;
    private string mensajeError = string.Empty;
    private string mensajeExitoCatalogo = string.Empty;

    // Modales de alta rápida de Conductor y Ruta
    private bool mostrarModalConductor = false;
    private bool mostrarModalRuta = false;
    private bool guardandoCatalogo = false;
    private string errorModalCatalogo = string.Empty;
    private Conductor nuevoConductor = new() { Licencia = "Cat. C - Pesados", Disponible = true };
    private Ruta nuevaRuta = new() { Origen = "Almacén Central SCZ", DistanciaKm = 20.0m };

    private decimal PesoTotalCalculado => (solicitudEnvio.ItemsCarga ?? new List<ItemCargaRequestDto>()).Sum(item =>
    {
        var prod = productosDisponibles.FirstOrDefault(p => p.Id == item.ProductoId);
        return (prod?.PesoUnitarioKg ?? 0m) * item.Cantidad;
    });

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listaClientes = await ObtenerListaSeguraAsync<Cliente>("api/clientes");
            listaConductores = await ObtenerListaSeguraAsync<Conductor>("api/conductores");
            listaRutas = await ObtenerListaSeguraAsync<Ruta>("api/rutas");
            productosDisponibles = await ObtenerListaSeguraAsync<Producto>("api/productos?soloDisponibles=true");

            if (listaConductores.Any())
                solicitudEnvio.ConductorId = listaConductores.First().Id;

            if (listaRutas.Any())
                solicitudEnvio.RutaId = listaRutas.First().Id;
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudieron cargar los catálogos iniciales: {ex.Message}";
        }
    }

    private async Task<List<T>> ObtenerListaSeguraAsync<T>(string url)
    {
        try
        {
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var lista = await response.Content.ReadFromJsonAsync<List<T>>();
                return lista ?? new List<T>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SITEL EnvioNuevo] Aviso al consultar {url}: {ex.Message}");
        }
        return new List<T>();
    }

    private static string GenerarCodigoGuia() =>
        $"SIT-{DateTime.Now:yyyyMMdd}-{Random.Shared.Next(1000, 9999)}";

    private void GenerarNuevaGuia()
    {
        solicitudEnvio.Guia = GenerarCodigoGuia();
    }

    private void OnClienteSeleccionado(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int idCliente))
        {
            solicitudEnvio.ClienteId = idCliente;
            var cli = listaClientes.FirstOrDefault(c => c.Id == idCliente);
            if (cli != null)
            {
                solicitudEnvio.Destinatario = cli.NombreRazonSocial;
                solicitudEnvio.DireccionEntrega = cli.Direccion;
            }
        }
    }

    private int DisponibilidadRestante(Producto prod)
    {
        var enCarrito = (solicitudEnvio.ItemsCarga ?? new List<ItemCargaRequestDto>())
            .Where(i => i.ProductoId == prod.Id)
            .Sum(i => i.Cantidad);
        return Math.Max(0, prod.StockActual - enCarrito);
    }

    private void AgregarItemCarga()
    {
        mensajeError = string.Empty;
        if (productoSeleccionadoId <= 0)
        {
            mensajeError = "Seleccione un producto del inventario antes de añadirlo.";
            return;
        }

        if (cantidadSeleccionada <= 0)
        {
            mensajeError = "La cantidad debe ser al menos 1.";
            return;
        }

        var prod = productosDisponibles.FirstOrDefault(p => p.Id == productoSeleccionadoId);
        if (prod == null) return;

        int disponible = DisponibilidadRestante(prod);
        if (cantidadSeleccionada > disponible)
        {
            mensajeError = $"Stock insuficiente para '{prod.Nombre}'. Disponible para agregar: {disponible} {prod.UnidadMedida}.";
            return;
        }

        var existente = solicitudEnvio.ItemsCarga.FirstOrDefault(i => i.ProductoId == prod.Id);
        if (existente != null)
        {
            existente.Cantidad += cantidadSeleccionada;
        }
        else
        {
            solicitudEnvio.ItemsCarga.Add(new ItemCargaRequestDto
            {
                ProductoId = prod.Id,
                Cantidad = cantidadSeleccionada,
                ObservacionItem = $"{prod.CodigoSku} - {prod.Nombre}"
            });
        }

        ActualizarResumenDescripcionCarga();
        productoSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }

    private void QuitarItemCarga(int productoId)
    {
        solicitudEnvio.ItemsCarga.RemoveAll(i => i.ProductoId == productoId);
        ActualizarResumenDescripcionCarga();
    }

    private void ActualizarResumenDescripcionCarga()
    {
        if (!solicitudEnvio.ItemsCarga.Any()) return;

        var partes = solicitudEnvio.ItemsCarga.Select(i =>
        {
            var p = productosDisponibles.FirstOrDefault(x => x.Id == i.ProductoId);
            return p != null ? $"{i.Cantidad} {p.UnidadMedida} de {p.Nombre}" : $"{i.Cantidad} unid.";
        });

        solicitudEnvio.DescripcionCarga = string.Join(" + ", partes);
    }

    private void AbrirModalConductorRapido()
    {
        errorModalCatalogo = string.Empty;
        nuevoConductor = new Conductor { Licencia = "Cat. C - Pesados", Disponible = true };
        mostrarModalConductor = true;
    }

    private void AbrirModalRutaRapida()
    {
        errorModalCatalogo = string.Empty;
        nuevaRuta = new Ruta { Origen = "Almacén Central SCZ", DistanciaKm = 20.0m };
        mostrarModalRuta = true;
    }

    private async Task GuardarConductorRapidoAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevoConductor.Nombres) ||
            string.IsNullOrWhiteSpace(nuevoConductor.Apellidos) ||
            string.IsNullOrWhiteSpace(nuevoConductor.Documento))
        {
            errorModalCatalogo = "Nombres, apellidos y documento son obligatorios.";
            return;
        }

        guardandoCatalogo = true;
        errorModalCatalogo = string.Empty;

        try
        {
            var resp = await Http.PostAsJsonAsync("api/conductores", nuevoConductor);
            if (resp.IsSuccessStatusCode)
            {
                var creado = await resp.Content.ReadFromJsonAsync<Conductor>();
                listaConductores = await ObtenerListaSeguraAsync<Conductor>("api/conductores");
                if (creado != null && creado.Id > 0)
                {
                    solicitudEnvio.ConductorId = creado.Id;
                }
                mostrarModalConductor = false;
                mensajeExitoCatalogo = $"Conductor '{nuevoConductor.Nombres} {nuevoConductor.Apellidos}' creado y seleccionado.";
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ApiMessageResponse>();
                errorModalCatalogo = err?.Mensaje ?? "No se pudo registrar el conductor.";
            }
        }
        catch (Exception ex)
        {
            errorModalCatalogo = $"Error: {ex.Message}";
        }
        finally
        {
            guardandoCatalogo = false;
        }
    }

    private async Task GuardarRutaRapidaAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevaRuta.Nombre) ||
            string.IsNullOrWhiteSpace(nuevaRuta.Origen) ||
            string.IsNullOrWhiteSpace(nuevaRuta.Destino))
        {
            errorModalCatalogo = "Nombre, origen y destino son obligatorios.";
            return;
        }

        guardandoCatalogo = true;
        errorModalCatalogo = string.Empty;

        try
        {
            var resp = await Http.PostAsJsonAsync("api/rutas", nuevaRuta);
            if (resp.IsSuccessStatusCode)
            {
                var creada = await resp.Content.ReadFromJsonAsync<Ruta>();
                listaRutas = await ObtenerListaSeguraAsync<Ruta>("api/rutas");
                if (creada != null && creada.Id > 0)
                {
                    solicitudEnvio.RutaId = creada.Id;
                }
                mostrarModalRuta = false;
                mensajeExitoCatalogo = $"Ruta '{nuevaRuta.Nombre}' creada y seleccionada.";
            }
            else
            {
                var err = await resp.Content.ReadFromJsonAsync<ApiMessageResponse>();
                errorModalCatalogo = err?.Mensaje ?? "No se pudo registrar la ruta.";
            }
        }
        catch (Exception ex)
        {
            errorModalCatalogo = $"Error: {ex.Message}";
        }
        finally
        {
            guardandoCatalogo = false;
        }
    }

    private async Task GuardarDespachoAsync()
    {
        if (solicitudEnvio.ClienteId <= 0)
        {
            mensajeError = "Debe seleccionar un cliente destinatario válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(solicitudEnvio.DescripcionCarga))
        {
            mensajeError = "Debe ingresar o seleccionar la descripción de la carga.";
            return;
        }

        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/envios", solicitudEnvio);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/mis-envios");
            }
            else
            {
                try
                {
                    var err = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
                    mensajeError = err?.Mensaje ?? "No se pudo registrar el despacho. Verifique los datos.";
                }
                catch
                {
                    mensajeError = "Error de validación al registrar el despacho.";
                }
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de conexión con el servidor: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/mis-envios");
}
