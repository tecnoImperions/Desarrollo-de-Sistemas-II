@page "/clientes"
@using System.Net.Http.Json
@using SITEL.Shared.DTOs
@using SITEL.Shared.Entities
@inject HttpClient Http

<PageTitle>SITEL | Directorio de Clientes</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 style="font-weight: 800; margin: 0; font-size: 1.55rem; color: #0F172A;">
            <i class="bi bi-people-fill text-primary me-2"></i>Directorio Corporativo de Clientes
        </h2>
        <p style="color: var(--text-muted); margin: 0.25rem 0 0; font-size: 0.9rem;">
            Gestión CRUD de empresas remitentes y destinatarias con validación de NIT único e integridad referencial.
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge-sitel badge-asignado">
            <i class="bi bi-building-check"></i> @(clientes?.Count ?? 0) Clientes Registrados
        </span>
    </div>
</div>

<!-- Tarjetas de Resumen Rápido -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="sitel-kpi-card">
            <div class="d-flex justify-content-between align-items-center">
                <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Total Empresas Activas</span>
                <i class="bi bi-buildings text-primary fs-5"></i>
            </div>
            <div style="font-size: 1.65rem; font-weight: 800; color: #0F172A; margin-top: 0.2rem;">@(clientes?.Count ?? 0)</div>
            <div style="font-size: 0.8rem; color: #2563EB; font-weight: 600;">Habilitadas para órdenes de despacho</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sitel-kpi-card" style="border-left-color: #3B82F6;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Con Despachos Asociados</span>
                <i class="bi bi-diagram-3-fill text-primary fs-5"></i>
            </div>
            <div style="font-size: 1.65rem; font-weight: 800; color: #0F172A; margin-top: 0.2rem;">
                @(conteoEnviosPorCliente?.Count(kv => kv.Value > 0) ?? 0)
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Con historial activo en trazabilidad</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="sitel-kpi-card" style="border-left-color: #10B981;">
            <div class="d-flex justify-content-between align-items-center">
                <span style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted);">Control de Duplicados</span>
                <i class="bi bi-shield-fill-check text-success fs-5"></i>
            </div>
            <div style="font-size: 1.1rem; font-weight: 700; color: #15803D; margin-top: 0.45rem;">
                <i class="bi bi-check-circle-fill me-1"></i>Validación NIT Activa
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">Verificación preventiva en cliente y API</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Formulario de Creación / Edición -->
    <div class="col-lg-4">
        <div class="sitel-card">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                <h5 style="font-weight: 700; margin: 0; color: #0F172A; font-size: 1.05rem;">
                    @if (modoEdicion)
                    {
                        <span><i class="bi bi-pencil-square text-primary me-2"></i>Editar Cliente</span>
                    }
                    else
                    {
                        <span><i class="bi bi-person-plus-fill text-primary me-2"></i>Registrar Nuevo Cliente</span>
                    }
                </h5>
                @if (modoEdicion)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelarEdicion">
                        <i class="bi bi-x-lg"></i> Cancelar
                    </button>
                }
            </div>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert @(esError ? "alert-danger" : "alert-success") py-2 px-3 small mb-3" role="alert">
                    <i class="bi @(esError ? "bi-exclamation-octagon-fill" : "bi-check-circle-fill") me-1"></i>
                    <strong>@(esError ? "Atención:" : "Éxito:")</strong> @mensaje
                </div>
            }

            <EditForm Model="@clienteFormulario" OnValidSubmit="GuardarCliente">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Razón Social / Nombre Completo <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="clienteFormulario.NombreRazonSocial" placeholder="Ej. Importadora Cruz del Sur S.R.L." />
                    <ValidationMessage For="@(() => clienteFormulario.NombreRazonSocial)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">NIT / Documento Tributario <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="clienteFormulario.DocumentoNit" placeholder="Ej. 1028495023" />
                    <ValidationMessage For="@(() => clienteFormulario.DocumentoNit)" class="text-danger small" />
                    @if (NitDuplicadoLocal)
                    {
                        <div class="text-danger small mt-1 fw-semibold">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>Este NIT ya se encuentra registrado en otro cliente del directorio.
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Correo Electrónico <span class="text-danger">*</span></label>
                    <InputText type="email" class="form-control" @bind-Value="clienteFormulario.Correo" placeholder="logistica@empresa.com.bo" />
                    <ValidationMessage For="@(() => clienteFormulario.Correo)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Teléfono de Contacto <span class="text-danger">*</span></label>
                    <InputText class="form-control" @bind-Value="clienteFormulario.Telefono" placeholder="Ej. 70012345 / 3-3456789" />
                    <ValidationMessage For="@(() => clienteFormulario.Telefono)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-secondary">Dirección Fiscal / Recepción <span class="text-danger">*</span></label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="clienteFormulario.Direccion" placeholder="Ej. Av. Cristo Redentor 4to Anillo, Parque Industrial" />
                    <ValidationMessage For="@(() => clienteFormulario.Direccion)" class="text-danger small" />
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn-sitel-primary justify-content-center" disabled="@(guardando || NitDuplicadoLocal)">
                        @if (guardando)
                        {
                            <span><i class="bi bi-arrow-repeat me-1"></i>Procesando...</span>
                        }
                        else if (modoEdicion)
                        {
                            <span><i class="bi bi-floppy-fill me-1"></i>Guardar Cambios</span>
                        }
                        else
                        {
                            <span><i class="bi bi-plus-circle-fill me-1"></i>Registrar Cliente</span>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <!-- Tabla de Clientes -->
    <div class="col-lg-8">
        <div class="sitel-card mb-3" style="padding: 1rem 1.25rem;">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0"
                               placeholder="Buscar por Razón Social, NIT, Correo o Dirección..."
                               @bind="filtroBusqueda" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <button class="btn-sitel-outline" @onclick="CargarDatosAsync">
                        <i class="bi bi-arrow-clockwise"></i> Actualizar Lista
                    </button>
                </div>
            </div>
        </div>

        <div class="sitel-card" style="padding: 0; overflow: hidden;">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 mb-0 small text-muted">Cargando directorio de clientes...</p>
                </div>
            }
            else if (!ClientesFiltrados.Any())
            {
                <div class="text-center py-5 px-3">
                    <i class="bi bi-people fs-2 text-muted d-block mb-2"></i>
                    <p style="color: var(--text-muted); margin: 0; font-weight: 600;">No se encontraron clientes que coincidan con el criterio de búsqueda.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="sitel-table">
                        <thead>
                            <tr>
                                <th>Razón Social / Correo</th>
                                <th>NIT / Documento</th>
                                <th>Teléfono</th>
                                <th>Dirección</th>
                                <th class="text-center">Envíos</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in ClientesFiltrados)
                            {
                                var totalEnvios = conteoEnviosPorCliente != null && conteoEnviosPorCliente.TryGetValue(c.Id, out var count) ? count : 0;
                                <tr>
                                    <td>
                                        <div style="font-weight: 700; color: #0F172A;">@c.NombreRazonSocial</div>
                                        <div style="font-size: 0.78rem; color: #2563EB;">
                                            <i class="bi bi-envelope me-1"></i>@(string.IsNullOrWhiteSpace(c.Correo) ? "Sin correo registrado" : c.Correo)
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge-sitel badge-registrado" style="font-family: monospace;">
                                            <i class="bi bi-card-text"></i> @c.DocumentoNit
                                        </span>
                                    </td>
                                    <td style="font-weight: 500;">
                                        <i class="bi bi-telephone text-muted me-1"></i>@c.Telefono
                                    </td>
                                    <td style="color: var(--text-muted); font-size: 0.84rem; max-width: 240px;">
                                        <i class="bi bi-geo-alt text-muted me-1"></i>@c.Direccion
                                    </td>
                                    <td class="text-center">
                                        <span class="badge-sitel @(totalEnvios > 0 ? "badge-asignado" : "badge-anulado")" style="text-decoration: none;">
                                            @totalEnvios
                                        </span>
                                    </td>
                                    <td class="text-end" style="white-space: nowrap;">
                                        <button class="btn-sitel-outline me-1" title="Editar Cliente" @onclick="() => IniciarEdicion(c)">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" style="border-radius: 8px; font-weight: 600; font-size: 0.82rem;"
                                                title="Eliminar Cliente" @onclick="() => ConfirmarEliminacion(c)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de Confirmación para Eliminar Cliente -->
@if (clientePorEliminar != null)
{
    <div class="sitel-modal-backdrop" @onclick="CerrarModalEliminar">
        <div class="sitel-modal" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="sitel-modal-header">
                <h5 style="margin: 0; font-size: 1.05rem; font-weight: 700;">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirmar Eliminación de Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalEliminar"></button>
            </div>
            <div class="sitel-modal-body">
                <p style="margin-bottom: 0.75rem; color: #334155;">
                    ¿Está seguro de que desea eliminar al siguiente cliente del directorio corporativo?
                </p>
                <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 8px; padding: 0.85rem 1rem;">
                    <div style="font-weight: 700; color: #0F172A;">@clientePorEliminar.NombreRazonSocial</div>
                    <div style="font-size: 0.85rem; color: #64748B;">NIT: @clientePorEliminar.DocumentoNit | Tel: @clientePorEliminar.Telefono</div>
                </div>
                @if (conteoEnviosPorCliente != null && conteoEnviosPorCliente.TryGetValue(clientePorEliminar.Id, out var enviosAsociados) && enviosAsociados > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0 py-2 small">
                        <i class="bi bi-shield-exclamation me-1"></i><strong>Protección Relacional:</strong> Este cliente tiene <strong>@enviosAsociados despacho(s)</strong> asociados. El servidor bloqueará la eliminación para preservar el historial de trazabilidad.
                    </div>
                }
            </div>
            <div class="sitel-modal-footer">
                <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                <button type="button" class="btn btn-danger fw-semibold" @onclick="EjecutarEliminacionAsync" disabled="@eliminando">
                    <i class="bi bi-trash3-fill me-1"></i>@(eliminando ? "Eliminando..." : "Confirmar Eliminación")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Cliente> clientes = new();
    private Dictionary<int, int> conteoEnviosPorCliente = new();

    private Cliente clienteFormulario = new();
    private Cliente? clientePorEliminar;

    private string filtroBusqueda = string.Empty;
    private bool cargando = true;
    private bool guardando = false;
    private bool eliminando = false;
    private bool modoEdicion = false;
    private string mensaje = string.Empty;
    private bool esError = false;

    private bool NitDuplicadoLocal =>
        clienteFormulario != null &&
        !string.IsNullOrWhiteSpace(clienteFormulario.DocumentoNit) &&
        clientes != null &&
        clientes.Any(c =>
            c != null &&
            c.Id != clienteFormulario.Id &&
            string.Equals(c.DocumentoNit?.Trim(), clienteFormulario.DocumentoNit.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<Cliente> ClientesFiltrados => (clientes ?? new List<Cliente>())
        .Where(c => c != null && (string.IsNullOrWhiteSpace(filtroBusqueda) ||
                    (c.NombreRazonSocial?.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.DocumentoNit?.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.Correo?.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (c.Direccion?.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        cargando = true;
        try
        {
            clientes = await ObtenerListaSeguraAsync<Cliente>("api/clientes");
            var envios = await ObtenerListaSeguraAsync<Envio>("api/envios");

            conteoEnviosPorCliente = envios
                .Where(e => e != null && e.ClienteId > 0)
                .GroupBy(e => e.ClienteId)
                .ToDictionary(g => g.Key, g => g.Count());
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"No se pudo sincronizar el directorio: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task<List<T>> ObtenerListaSeguraAsync<T>(string url)
    {
        try
        {
            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var lista = await response.Content.ReadFromJsonAsync<List<T>>();
                return lista ?? new List<T>();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[SITEL Clientes] Aviso al consultar {url}: {ex.Message}");
        }
        return new List<T>();
    }

    private async Task GuardarCliente()
    {
        if (NitDuplicadoLocal)
        {
            esError = true;
            mensaje = "El NIT ingresado ya pertenece a otro cliente registrado.";
            return;
        }

        guardando = true;
        mensaje = string.Empty;

        try
        {
            HttpResponseMessage response = modoEdicion
                ? await Http.PutAsJsonAsync($"api/clientes/{clienteFormulario.Id}", clienteFormulario)
                : await Http.PostAsJsonAsync("api/clientes", clienteFormulario);

            if (response.IsSuccessStatusCode)
            {
                esError = false;
                mensaje = modoEdicion
                    ? "Datos del cliente actualizados correctamente."
                    : "Nuevo cliente registrado exitosamente en el directorio.";

                clienteFormulario = new Cliente();
                modoEdicion = false;
                await CargarDatosAsync();
            }
            else
            {
                esError = true;
                var errorObj = await LeerErrorSeguroAsync(response);
                mensaje = errorObj ?? "Error de validación al guardar el cliente.";
            }
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"Error de comunicación con el servidor: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void IniciarEdicion(Cliente? c)
    {
        if (c == null) return;
        mensaje = string.Empty;
        modoEdicion = true;
        clienteFormulario = new Cliente
        {
            Id = c.Id,
            NombreRazonSocial = c.NombreRazonSocial,
            DocumentoNit = c.DocumentoNit,
            Correo = c.Correo,
            Telefono = c.Telefono,
            Direccion = c.Direccion
        };
    }

    private void CancelarEdicion()
    {
        modoEdicion = false;
        clienteFormulario = new Cliente();
        mensaje = string.Empty;
    }

    private void ConfirmarEliminacion(Cliente? c)
    {
        if (c == null) return;
        mensaje = string.Empty;
        clientePorEliminar = c;
    }

    private void CerrarModalEliminar()
    {
        clientePorEliminar = null;
    }

    private async Task EjecutarEliminacionAsync()
    {
        if (clientePorEliminar == null) return;

        eliminando = true;
        try
        {
            var response = await Http.DeleteAsync($"api/clientes/{clientePorEliminar.Id}");
            if (response.IsSuccessStatusCode)
            {
                esError = false;
                mensaje = $"El cliente '{clientePorEliminar.NombreRazonSocial}' fue eliminado.";
                clientePorEliminar = null;
                await CargarDatosAsync();
            }
            else
            {
                esError = true;
                mensaje = await LeerErrorSeguroAsync(response) ?? "No se pudo eliminar el cliente seleccionado.";
                clientePorEliminar = null;
            }
        }
        catch (Exception ex)
        {
            esError = true;
            mensaje = $"Error al intentar eliminar: {ex.Message}";
            clientePorEliminar = null;
        }
        finally
        {
            eliminando = false;
        }
    }

    private static async Task<string?> LeerErrorSeguroAsync(HttpResponseMessage response)
    {
        try
        {
            var err = await response.Content.ReadFromJsonAsync<ApiMessageResponse>();
            return err?.Mensaje;
        }
        catch
        {
            return null;
        }
    }
}
