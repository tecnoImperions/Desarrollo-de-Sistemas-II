@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using SITEL.Client.Services
@inject AuthService Auth
@inject NavigationManager Navigation

@if (!sesionVerificada)
{
    <!-- Verificando sesión (evita mostrar contenido protegido antes de validar RNF01) -->
    <div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #0F172A;">
        <div class="spinner-border text-light" role="status">
            <span class="visually-hidden">Verificando sesión...</span>
        </div>
    </div>
}
else if (EsRutaPublica)
{
    <!-- Vista de pantalla completa sin menú lateral para /login y /rastreo -->
    <div class="sitel-public-shell">
        @Body
    </div>
}
else if (!sesionActual.Autenticado || !ControlAcceso.PuedeAcceder(sesionActual.Rol, RutaActual))
{
    <!-- Sin sesión o sin permiso: se está redirigiendo (RNF01) -->
    <div class="sitel-redirect" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: #0F172A; color: #CBD5E1;">
        <div class="text-center">
            <div class="spinner-border text-light mb-2" role="status"></div>
            <div style="font-size: 0.85rem;">Redirigiendo al acceso seguro...</div>
        </div>
    </div>
}
else if (string.Equals(sesionActual.Rol, "Conductor", StringComparison.OrdinalIgnoreCase))
{
    <!-- Shell móvil para el Conductor: barra superior SITEL Móvil + contenido -->
    <div class="sitel-mobile-shell">
        <header class="sitel-mobile-topbar">
            <div class="d-flex align-items-center gap-2">
                <span style="background: #2563EB; padding: 0.25rem 0.5rem; border-radius: 8px; display: inline-flex; align-items: center;">
                    <i class="bi bi-box-seam-fill text-white"></i>
                </span>
                <span style="font-weight: 800; font-size: 1rem;">SITEL <span style="color: #60A5FA; font-weight: 600;">Móvil</span></span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1"
                    style="border-radius: 8px; font-weight: 600; font-size: 0.78rem; min-height: 36px;"
                    title="Cerrar Sesión" @onclick="CerrarSesionAsync">
                <i class="bi bi-box-arrow-right"></i>
                <span>Salir</span>
            </button>
        </header>

        <main class="sitel-mobile-content">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="sitel-card m-3" style="border-left: 4px solid #EF4444;">
                        <h6 class="fw-bold text-danger mb-2">Error en vista móvil</h6>
                        <p class="small text-secondary mb-3"><code>@ex.Message</code></p>
                        <button class="btn-sitel-primary w-100 justify-content-center" @onclick="RecuperarEstado">Reintentar</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </div>
}
else
{
    <div class="sitel-shell">
        <div class="sitel-sidebar">
            <NavMenu Rol="@sesionActual.Rol" />
        </div>

        <div class="sitel-main">
            <div class="sitel-topbar">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check" style="color: #2563EB; font-size: 1.15rem;"></i>
                    <span style="font-weight: 700; font-size: 1rem; color: #0F172A; letter-spacing: -0.01em;">
                        SITEL — Sistema de Trazabilidad Logística
                    </span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span style="font-size: 0.82rem; color: #334155; font-weight: 600;" class="d-none d-md-inline">
                        <i class="bi bi-person-circle me-1 text-primary"></i>@sesionActual.NombreCompleto
                    </span>
                    <span style="font-size: 0.76rem; font-weight: 700; color: #1D4ED8; background: #DBEAFE; border: 1px solid #BFDBFE; padding: 0.25rem 0.7rem; border-radius: 999px;">
                        <i class="bi bi-award-fill me-1"></i>@FormatearRol(sesionActual.Rol)
                    </span>

                    <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1"
                            style="border-radius: 8px; font-weight: 600; font-size: 0.8rem;"
                            title="Cerrar Sesión" @onclick="CerrarSesionAsync">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="d-none d-sm-inline">Salir</span>
                    </button>
                </div>
            </div>

            <div class="sitel-content">
                <ErrorBoundary @ref="errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="sitel-card" style="border-left: 4px solid #EF4444;">
                            <div class="d-flex align-items-center gap-2 mb-2 text-danger">
                                <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                <h5 class="m-0 fw-bold">Se interceptó una excepción controlada en el componente</h5>
                            </div>
                            <p class="small text-secondary mb-3">
                                Detalle técnico: <code>@ex.Message</code>
                            </p>
                            <button class="btn-sitel-primary" @onclick="RecuperarEstado">
                                <i class="bi bi-arrow-clockwise"></i> Reintentar Carga del Módulo
                            </button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </div>
        </div>
    </div>
}

@code {
    private ErrorBoundary? errorBoundary;
    private SesionActualDto sesionActual = new();
    private bool sesionVerificada;

    private string RutaActual => ControlAcceso.NormalizarRuta(Navigation.ToBaseRelativePath(Navigation.Uri));

    private bool EsRutaPublica => ControlAcceso.EsRutaPublica(RutaActual);

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += AlCambiarUbicacion;
        Auth.OnAuthStateChanged += AlCambiarSesion;
        await SincronizarYAplicarAccesoAsync();
    }

    private void AlCambiarUbicacion(object? sender, LocationChangedEventArgs e)
    {
        errorBoundary?.Recover();
        _ = InvokeAsync(SincronizarYAplicarAccesoAsync);
    }

    private void AlCambiarSesion() => _ = InvokeAsync(SincronizarYAplicarAccesoAsync);

    /// <summary>
    /// RNF01: valida la sesión en cada navegación. Sin sesión → /login.
    /// Con sesión pero sin permiso para la ruta → ruta de inicio de su rol.
    /// </summary>
    private async Task SincronizarYAplicarAccesoAsync()
    {
        try
        {
            sesionActual = await Auth.ObtenerSesionActualAsync();
        }
        catch
        {
            sesionActual = new SesionActualDto();
        }

        sesionVerificada = true;

        var ruta = RutaActual;
        if (!ControlAcceso.EsRutaPublica(ruta))
        {
            if (!sesionActual.Autenticado)
            {
                Navigation.NavigateTo("/login", replace: true);
            }
            else if (!ControlAcceso.PuedeAcceder(sesionActual.Rol, ruta))
            {
                Navigation.NavigateTo(ControlAcceso.RutaInicio(sesionActual.Rol), replace: true);
            }
        }

        StateHasChanged();
    }

    private async Task CerrarSesionAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    private void RecuperarEstado()
    {
        errorBoundary?.Recover();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= AlCambiarUbicacion;
        Auth.OnAuthStateChanged -= AlCambiarSesion;
    }

    private static string FormatearRol(string? rol) => rol switch
    {
        "Administrador" => "Administrador",
        "OperadorLogistico" => "Operador Logístico",
        "Conductor" => "Conductor de Flota",
        "Cliente" => "Cliente",
        _ => "Operador Logístico"
    };
}
